# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
TZ=Africa/Lagos
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated frontend origins allowed to call the API (dev server, Playwright, vite preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
# Frontend base URL, used in emails (password reset links)
FRONTEND_URL=http://localhost:5173

# ── MySQL ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kjt_foodie
DB_USER=kjt_foodie
DB_PASS=change-me
# Database used by `npm test` (wiped between test files). Must end in _test.
# Defaults to <DB_NAME>_test
DB_NAME_TEST=kjt_foodie_test
# Optional: run tests against another MySQL server (e.g. local, much faster than a remote one)
# DB_TEST_HOST=127.0.0.1
# DB_TEST_PORT=3306
# DB_TEST_USER=kjt_foodie
# DB_TEST_PASS=change-me
# DB_TEST_SSL=false
# Set to true for managed/cloud MySQL that requires TLS (e.g. TiDB Cloud)
DB_SSL=false
# Set to true to log SQL queries in development
DB_LOGGING=false

# ── Redis (cache, queues, rate limits, Socket.IO adapter) ──
REDIS_URL=redis://127.0.0.1:6379
# Every key is namespaced so dev and test can share one Redis. Defaults to kjt:<NODE_ENV>
# REDIS_KEY_PREFIX=kjt:development

# ── Auth ─────────────────────────────────────────────
# Long random strings, different from each other: `openssl rand -hex 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Refresh-token cookie (httpOnly). Secure must be true in production (HTTPS)
COOKIE_NAME=kjt_refresh
# Leave COOKIE_DOMAIN empty for localhost. COOKIE_SECURE defaults to true in production
COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax | strict | none (none needs COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
# OTP accepted outside production so demos and tests need no SMS
DEMO_OTP=123456
# bcrypt cost (12 in production; tests use 4)
BCRYPT_ROUNDS=12
# Google sign-in: OAuth client ID from Google Cloud Console (same as the frontend's)
GOOGLE_CLIENT_ID=

# ── Cloudinary (file uploads) ────────────────────────
# Find these on the Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder all uploads go under, e.g. kjt-foodie/food-photos
CLOUDINARY_UPLOAD_FOLDER=kjt-foodie

# ── Paystack (payments, subaccounts, banks) — phases 9, 12, 15 ──
# Test keys start with sk_test_ / pk_test_. Webhook signatures use the secret key.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Termii (SMS) — phase 5 ───────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=KJTFoodie
TERMII_BASE_URL=https://api.ng.termii.com

# ── Email — phase 5 ──────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM="KJT Foodie <no-reply@kjtfoodie.com>"

# ── Maps (optional; ETA via Distance Matrix, otherwise haversine) ──
GOOGLE_MAPS_API_KEY=
