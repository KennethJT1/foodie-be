# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
TZ=Africa/Lagos
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── MySQL ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kjt_foodie
DB_USER=kjt_foodie
DB_PASS=change-me
# Set to true for managed/cloud MySQL that requires TLS (e.g. TiDB Cloud)
DB_SSL=false
# Set to true to log SQL queries in development
DB_LOGGING=false

# ── Cloudinary (file uploads) ────────────────────────
# Find these on the Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder all uploads go under, e.g. kjt-foodie/food-photos
CLOUDINARY_UPLOAD_FOLDER=kjt-foodie
